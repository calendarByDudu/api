// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EventAudience {
  me
  couple
}

enum EventCategory {
  saidinha
  restaurante
  aniversario
  saude
  trabalho
  casa
  viagem
  outro
}

enum EventColor {
  blue
  green
  amber
  rose
  violet
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String
  coupleId     String?  @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  couple        Couple?           @relation(fields: [coupleId], references: [id], onDelete: SetNull)
  invite        CoupleInvite?
  passwordReset PasswordResetOtp?
  refreshTokens RefreshToken[]
  events        Event[]
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Max 2 members, enforced in app.
model Couple {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())

  members User[]
  events  Event[]
}

model CoupleInvite {
  code        String   @id @db.Char(6)
  createdById String   @unique @db.Uuid
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)
}

model PasswordResetOtp {
  userId    String   @id @db.Uuid
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Event {
  id          String        @id @default(uuid()) @db.Uuid
  title       String
  startsAt    DateTime      @db.Timestamp(0)
  endsAt      DateTime?     @db.Timestamp(0)
  allDay      Boolean       @default(false)
  notes       String?
  audience    EventAudience
  category    EventCategory
  color       EventColor
  createdById String        @db.Uuid
  coupleId    String?       @db.Uuid
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  createdBy User    @relation(fields: [createdById], references: [id], onDelete: Cascade)
  couple    Couple? @relation(fields: [coupleId], references: [id], onDelete: SetNull)

  @@index([createdById, startsAt])
  @@index([coupleId, startsAt])
}
